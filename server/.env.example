# ═══════════════════════════════════════════════════════════════════════════
#  server/.env  — copy to `server/.env` and fill in.
#
#  Every one of these is parsed by zod in src/env.ts at boot: a missing or
#  malformed value makes the server refuse to start and prints the field name.
#  Nothing here may ever appear in the frontend.
# ═══════════════════════════════════════════════════════════════════════════

PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# All IST math goes through Luxon with an explicit zone, but keep the host on
# UTC so log timestamps and any stray Date arithmetic agree with the database.
TZ=UTC


# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# sb_secret_... — bypasses RLS. NEVER put this in the frontend.
SUPABASE_SECRET_KEY=


# ── Google OAuth (Gmail API) ────────────────────────────────────────────────
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web app).
# Enable the Gmail API, set the consent screen to "In production", and add this
# exact redirect URI to the client's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback


# ── Secrets ─────────────────────────────────────────────────────────────────
# AES-256-GCM key for the stored Gmail refresh token. Exactly 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Signs tracking click URLs (an unsigned redirect is an open redirect) and the
# OAuth `state` parameter. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_HMAC_SECRET=

# Public origin the pixel and click links point at. Gmail's image proxy cannot
# reach localhost, so while testing tracking run
#   cloudflared tunnel --url http://localhost:8080
# and paste the https://….trycloudflare.com URL here.
#
# In production this must be a subdomain of a domain you own (the deployment uses
# https://track.udityakumar.dev) — never a free dynamic-DNS host. `duckdns.org`
# and friends are shared parent domains heavily abused for phishing: you inherit
# a reputation you can't influence, and network DNS filters block them outright,
# so the recipient can't reach the link at all. See DEPLOY-BACKEND.md Step 5.
TRACKING_BASE_URL=http://localhost:8080


# ── Frontend ────────────────────────────────────────────────────────────────
# CORS origin *and* where the OAuth callback redirects back to. No trailing slash.
FRONTEND_URL=http://localhost:5173


# ── Scheduler ───────────────────────────────────────────────────────────────
# Set to false to run the HTTP API without the in-process cron (e.g. when an
# external pinger drives POST /api/cron/tick instead).
SCHEDULER_ENABLED=true

# Shared secret for POST /api/cron/tick, sent as `X-Cron-Secret`. Required only
# if you drive the loop externally (Supabase pg_cron, cron-job.org, …).
# Minimum 16 characters.
CRON_SECRET=
