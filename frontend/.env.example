# Copy to .env for local development. On Vercel these go in Project Settings →
# Environment Variables instead; see DEPLOY.md.
#
# Every VITE_ variable is inlined into the JavaScript bundle at BUILD time and is
# readable by anyone who loads the page. Nothing secret belongs here — no
# sb_secret_... key, no Google client secret. Those live only in server/.env.
# Changing one of these needs a rebuild, not a restart.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_...), never the secret one. It is designed
# to ship in the bundle; RLS is what actually protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Origin of the Express server, no trailing slash. In production this is the AWS
# backend's URL. src/lib/api.ts throws at module load if it is missing.
VITE_SERVER_URL=http://localhost:8080
